# ==============================================================================
# FlashLogix Platform Environment Configuration
# Ports are isolated (5433, 6380, 9094, 9000) to avoid conflicts with local services
# ==============================================================================

# Application Settings
APP_NAME=FlashLogix
APP_ENV=development
DEBUG=False
LOG_LEVEL=INFO
CONCURRENCY_MODE=redis_async_lazy
HOST=0.0.0.0
PORT=8000

# PostgreSQL (OLTP & Star Schema Gold Layer)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=flashlogix_db
DATABASE_URL=postgresql://postgres:password123@localhost:5433/flashlogix_db

# Redis (Atomic In-Memory Cache)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=100
PRODUCT_CACHE_TTL_SEC=300
IDEMPOTENCY_TTL_SEC=86400

# Apache Kafka (Event Streaming & Dead-Letter Queue)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_ORDERS=flashsale.orders
KAFKA_TOPIC_ORDERS_DLQ=flashsale.orders.dlq
KAFKA_CONSUMER_GROUP=flashlogix_audit_group

# MinIO / Lakehouse S3 Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_BUCKET=lakehouse

# Data Governance, Fraud & Security
PII_SALT=FLASH_SECRET_SALT_2026
FRAUD_VELOCITY_THRESHOLD_PER_MIN=5
